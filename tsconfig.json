{
  "compilerOptions": {
    "target": "ES2022",
    // "module": "commonjs",
    "module": "ESNext", // <-- required for top-level await
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "outDir": "dist",
    // "ignoreDeprecations": "6.0",
    "allowJs": true,
    "skipLibCheck": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "noEmit": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
    // "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
